PORT=8000
CORS_ORIGIN=*
DATABASE_URL=sqlite:///./anvesha.db

#recommendation model
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# Optional tuning for the AI trip plans (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# LLM_TIMEOUT_SECONDS=25
# PLAN_SHORTLIST_SIZE=12
# Weather on the Itinerary page (OpenWeather, https://openweathermap.org/api - the free plan is enough)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Online payment on the Booking page (Razorpay). Use test keys (rzp_test_...) while developing: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
